# Virtual environments
.venv/
venv/
env/

# Python cache / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Datasets (large, auto-downloaded by the code)
/data/
*.npz
*.pkl

# Model checkpoints and heavy outputs
*.pt
*.pth
*.ckpt
checkpoints/
runs/
results/**/*.npy
# Half-written files from atomic saves (checkpoint.pt.tmp, metrics.csv.tmp, ...)
*.tmp

# Small result summaries (csv / json / png / log) stay tracked on purpose. The negations
# also override a global gitignore that ignores e.g. *.log. (final_model.pt and
# checkpoint.pt stay ignored through *.pt above.)
!results/**/*.csv
!results/**/*.json
!results/**/*.png
!results/**/*.log

# Editor / OS
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets / personal config
.env
*.local.yaml